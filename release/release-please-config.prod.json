{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"packages": {
		"packages/data-core": {
			"package-name": "data-core",
			"changelog-path": "docs/changelog.md"
		},
		"packages/data-json-ld": {
			"package-name": "data-json-ld",
			"changelog-path": "docs/changelog.md"
		},
		"packages/data-framework": {
			"package-name": "data-framework",
			"changelog-path": "docs/changelog.md"
		},
		"packages/data-json-path": {
			"package-name": "data-json-path",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"data-core",
				"data-json-ld",
				"data-framework",
				"data-json-path"
			]
		}
	]
}
