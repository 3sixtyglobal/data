{
	"name": "@twin.org/data-json-path",
	"version": "0.0.3-next.16",
	"description": "A consistent JSONPath query abstraction.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/data.git",
		"directory": "packages/data-json-path"
	},
	"contributors": [
		"adrian.sanchez.sequeira@iota.org",
		"cornel.filip@iota.org"
	],
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage src/schemas",
		"build:compile": "tspc",
		"build": "npm run build:compile",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/core": "next",
		"@twin.org/nameof": "next",
		"json-p3": "2.2.2"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@vitest/coverage-v8": "4.0.18",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"rollup": "4.59.0",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.17",
		"typedoc-plugin-markdown": "4.10.0",
		"typescript": "5.9.3",
		"vitest": "4.0.18"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"data-processing",
		"data",
		"processing",
		"transformation",
		"conversion"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/data/issues"
	},
	"homepage": "https://twindev.org"
}
